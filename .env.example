# Personal access token from https://developer.tibber.com/settings/access-token
TIBBER_TOKEN=

# Time zone used when a home does not report its own (IANA name).
TZ=Europe/Oslo

# Language the UI and reports start in: en or nb (Norwegian Bokmal).
# Each browser can switch language, and remembers its own choice.
TIBBER_LANGUAGE=en

# Pre-select this home in the UI.
TIBBER_POSTAL_CODE=

# Pre-fill the fixed-price override, in currency per kWh.
TIBBER_FIXED_PRICE=
TIBBER_FIXED_PRICE_INCLUDES_VAT=true

# Set to false to forbid entering a token in the UI (env token only).
TIBBER_ALLOW_TOKEN_OVERRIDE=true

# Largest allowed distance from "now" back to the report start, in hours.
TIBBER_MAX_LOOKBACK_HOURS=26280
